{
  "name": "opm-pdf-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pdfjs": "docker run --rm --user $(id -u):$(id -g) -e HOME=/tmp -v \"$PWD/vendor/pdfjs:/pdfjs\" -w /pdfjs node:24 sh -c \"npm ci --ignore-scripts --no-audit --no-fund && npx gulp dist\"",
    "build": "bun run scripts/build.ts",
    "start": "bun run src/server.ts",
    "dev": "bun run build && bun --watch run src/server.ts",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:build:win": "bash scripts/tauri-win-native.sh",
    "tauri:run:win": "bash scripts/tauri-run-win.sh",
    "tauri:build:win:cross": "bash scripts/tauri-win-build.sh"
  },
  "dependencies": {
    "pdfjs-dist": "file:vendor/pdfjs/build/dist",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0",
    "@tauri-apps/cli": "^2"
  }
}
